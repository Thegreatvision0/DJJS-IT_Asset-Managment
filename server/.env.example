# Copy to .env and edit
PORT=5000
# MongoDB Atlas or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/djjs_itam
# Long random secret for signing login tokens (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-string
# Login session length in hours
TOKEN_HOURS=36
# Time zone used for "today" in due-date checks
TZ=Asia/Kolkata
# Password for the first System Administrator created on an empty database (username: admin)
ADMIN_PASSWORD=ChangeMe@123
# DATA_STORE=memory runs without MongoDB (data kept in DATA_FILE) — for trying the app only
# DATA_STORE=memory
# DATA_FILE=./data/demo-data.json
